{
  "name": "corral",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "check": "node scripts/check-web-ui.mjs && vp check && vp run -r typecheck && vp test run --project node",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "vp run -r typecheck",
    "test": "vp test run --project node",
    "test:browser": "vp run --concurrency-limit 4 browser-all",
    "test:perf": "vp run -r test:perf",
    "test:e2e": "vp run -r test:e2e",
    "test:contracts": "vp run -r test:contracts",
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/dev.mjs --desktop",
    "seed": "node scripts/seed-dev.mjs",
    "workrun": "node scripts/workrun/cli.mjs",
    "test:workrun": "WORKRUN_SYSTEMD_TEST=1 vp test run --project node scripts/workrun --maxWorkers=1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxc-parser": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
